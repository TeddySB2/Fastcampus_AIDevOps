{
  "mcpServers": {
    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana@2.0.2",
        "--disable-write",
        "--enabled-tools",
        "search,datasource,prometheus,loki,tempo,alerting,dashboard",
        "--loki-guardrail-max-range",
        "24h"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL:-http://localhost:3000}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}",
        "GRAFANA_USAGE_STATS": "false"
      }
    }
  }
}
